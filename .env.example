# Supply variables through your shell or deployment environment. The app never
# opens .env. Make targets use Compose with --env-file /dev/null as well.
# Optional CONFIG_FILE points to a Viper YAML/TOML configuration for host binaries.
APP_ENV=development
HTTP_ADDR=:8080
# Docker service addresses. Host binaries use localhost:55432 / localhost:56379.
DATABASE_URL=postgres://shopnext:shopnext@postgres:5432/shopnext?sslmode=disable
REDIS_URL=redis://redis:6379/0
UPLOAD_DIR=/app/data/uploads
# Space-separated origins and trusted proxy CIDRs. Cookies need a same-site API
# hostname or same-origin reverse proxy when serving a separate frontend.
ALLOWED_ORIGINS=http://localhost:3000 http://localhost:8080
TRUSTED_PROXIES=
PAYMENT_PROVIDER=dev
PAYMENT_HOLD_MINUTES=15
PHAJAY_BASE_URL=https://payment-gateway.phajay.co
PHAJAY_SECRET_KEY=
PHAJAY_WEBHOOK_SECRET=
PHAJAY_WEBHOOK_SIGNATURE_HEADER=x-phajay-signature
SMS_PROVIDER=dev
WENOVA_BASE_URL=https://apimicroservices.wenova.fun
WENOVA_TOKEN=
WENOVA_SENDER_ID=WNV-info
WENOVA_USE_PACKAGE=true
# Production requires a random secret of at least 32 characters.
CRON_SECRET=
# Optional legacy shared-admin fallback: raw scrypt$salt$hexhash or base64 form.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Customer trusted-device JWT signing (explicit random secret required in production).
TRUST_DEVICE_SECRET=development-only-trust-device-secret-change-for-production
# Next.js server payment callback; HTTPS and a 32+ character secret in production.
CLIENT_PAYMENT_WEBHOOK_URL=
CLIENT_PAYMENT_WEBHOOK_SECRET=
