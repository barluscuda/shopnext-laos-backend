# Supply variables through your shell or deployment environment. The app never
# opens .env. Optional CONFIG_FILE points to a Viper YAML/TOML configuration.
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://shopnext:shopnext@localhost:55432/shopnext?sslmode=disable
REDIS_URL=redis://localhost:56379/0
UPLOAD_DIR=data/uploads
# Space-separated origins and trusted proxy CIDRs. Cookies need a same-site API
# hostname or same-origin reverse proxy when serving a separate frontend.
ALLOWED_ORIGINS=http://localhost:3000 http://localhost:8080
TRUSTED_PROXIES=
PAYMENT_PROVIDER=dev
PAYMENT_HOLD_MINUTES=15
PHAJAY_BASE_URL=https://payment-gateway.phajay.co
PHAJAY_SECRET_KEY=
PHAJAY_WEBHOOK_SECRET=
PHAJAY_WEBHOOK_SIGNATURE_HEADER=x-phajay-signature
SMS_PROVIDER=dev
WENOVA_BASE_URL=https://apimicroservices.wenova.fun
WENOVA_TOKEN=
WENOVA_SENDER_ID=WNV-info
WENOVA_USE_PACKAGE=true
# Production requires a random secret of at least 32 characters.
CRON_SECRET=
# Optional legacy shared-admin fallback: raw scrypt$salt$hexhash or base64 form.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
